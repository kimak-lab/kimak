{
  "name": "@kimak/core",
  "version": "0.1.0",
  "description": "Framework-agnostic machines, connect(), and platform primitives.",
  "license": "MIT",
  "homepage": "https://github.com/kimak-lab/kimak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimak-lab/kimak.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/kimak-lab/kimak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/spec": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
