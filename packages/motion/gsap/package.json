{
  "name": "@kimak/motion-gsap",
  "version": "0.0.0",
  "description": "Optional GSAP motion for Kimak anatomy selectors. Peer gsap; no look in machines.",
  "license": "MIT",
  "homepage": "https://github.com/kimak-lab/kimak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimak-lab/kimak.git",
    "directory": "packages/motion/gsap"
  },
  "bugs": {
    "url": "https://github.com/kimak-lab/kimak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/spec": "workspace:*"
  },
  "peerDependencies": {
    "gsap": "^3.12.0"
  },
  "devDependencies": {
    "gsap": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
