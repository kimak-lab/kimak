{
  "name": "@kimak/ui-vue",
  "version": "0.0.0",
  "description": "Vue product layer over @kimak/headless-vue. Look still comes from @kimak/tailwind.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/headless-vue": "workspace:*",
    "@kimak/motion-gsap": "workspace:*"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@kimak/core": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "gsap": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
