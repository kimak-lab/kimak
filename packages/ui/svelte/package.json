{
  "name": "@kimak/ui-svelte",
  "version": "0.0.0",
  "description": "Svelte product layer over @kimak/headless-svelte. Look still comes from @kimak/tailwind.",
  "license": "MIT",
  "homepage": "https://github.com/kimak-lab/kimak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimak-lab/kimak.git",
    "directory": "packages/ui/svelte"
  },
  "bugs": {
    "url": "https://github.com/kimak-lab/kimak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/headless-svelte": "workspace:*",
    "@kimak/motion-gsap": "workspace:*"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "gsap": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
