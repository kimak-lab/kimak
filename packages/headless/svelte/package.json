{
  "name": "@kimak/headless-svelte",
  "version": "0.0.0",
  "description": "Svelte 5 headless adapter for Kimak. Parts only; look lives in @kimak/tailwind.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/core": "workspace:*",
    "@kimak/spec": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
