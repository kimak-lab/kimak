{
  "name": "@kimak/headless-svelte",
  "version": "0.0.0",
  "description": "Svelte 5 headless adapter for Kimak. Parts only; look lives in @kimak/tailwind.",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "svelte": "./dist/button/index.js",
      "import": "./dist/button/index.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox/index.d.ts",
      "svelte": "./dist/checkbox/index.js",
      "import": "./dist/checkbox/index.js"
    },
    "./dialog": {
      "types": "./dist/dialog/index.d.ts",
      "svelte": "./dist/dialog/index.js",
      "import": "./dist/dialog/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/example.*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/core": "workspace:*",
    "@kimak/spec": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@testing-library/user-event": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
