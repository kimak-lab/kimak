{
  "name": "@kimak/headless-vue",
  "version": "0.1.0",
  "description": "Vue 3 headless adapter for Kimak. Parts only; look lives in @kimak/tailwind.",
  "license": "MIT",
  "homepage": "https://github.com/kimak-lab/kimak#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimak-lab/kimak.git",
    "directory": "packages/headless/vue"
  },
  "bugs": {
    "url": "https://github.com/kimak-lab/kimak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kimak/core": "workspace:*",
    "@kimak/spec": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
