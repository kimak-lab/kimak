---
import { buttonAttrs } from "@kimak/ui-react";
import corePkg from "../../../../packages/core/package.json";
import { nav } from "../lib/nav";
import { chromeIdleVariant } from "../lib/chrome";
import { IconLibraryPicker } from "./IconLibraryPicker";
import SearchDialog from "./SearchDialog.astro";
import { ThemePicker } from "./ThemePicker";

interface Props {
  nav?: boolean;
}

const { nav: hasNav = false } = Astro.props;
const github = "https://github.com/kimak-lab/kimak";
const releases = `${github}/releases`;
const version = `v${corePkg.version}`;
const pathname = Astro.url.pathname;
const componentsHref =
  nav.find((section) => section.title === "Components")?.items[0]?.href ?? "/docs/components/button";
const onComponents = pathname.startsWith("/docs/components");
const onDocs = pathname.startsWith("/docs") && !onComponents;
const iconLook = buttonAttrs({ variant: chromeIdleVariant, size: "icon-sm" });
const primaryLink =
  "text-[0.9rem] text-muted-foreground hover:text-foreground aria-[current=true]:text-foreground";
---

<header
  class="sticky top-0 z-30 flex h-14 items-center justify-between gap-4 border-b border-border bg-docs-header px-5 backdrop-blur-[14px] max-nav:px-[0.85rem]"
>
  <div class="flex items-center gap-3">
    {
      hasNav ? (
        <span class="hidden max-nav:inline-flex">
          <button
            type="button"
            {...iconLook}
            class="group"
            data-toggle-nav
            aria-expanded="false"
            aria-controls="docs-nav"
            aria-label="Docs navigation"
          >
            <svg
              class="group-aria-expanded:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
            <svg
              class="hidden group-aria-expanded:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </span>
      ) : null
    }
    <a class="font-[650] tracking-[-0.04em]" href="/">Kimak</a>
    <a
      class="rounded-full border border-border px-2 py-px font-mono text-[0.7rem] text-muted-foreground hover:text-foreground"
      href={releases}
      title="Release notes"
      aria-label={`Kimak ${version} release notes`}
    >
      {version}
    </a>
    <nav class="ml-2 flex items-center gap-4 max-nav:hidden" aria-label="Primary">
      <a class={primaryLink} href="/docs/getting-started" aria-current={onDocs ? "true" : undefined}>
        Docs
      </a>
      <a class={primaryLink} href={componentsHref} aria-current={onComponents ? "true" : undefined}>
        Components
      </a>
    </nav>
  </div>
  <div class="flex items-center gap-3 max-nav:gap-2">
    <button
      type="button"
      {...buttonAttrs({ variant: chromeIdleVariant, size: "sm" })}
      class="w-52 justify-start font-normal text-muted-foreground max-toc:hidden"
      data-open-search
      aria-haspopup="dialog"
      aria-keyshortcuts="Control+K Meta+K /"
    >
      <svg
        data-icon="inline-start"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      Search docs…
      <kbd
        class="ml-auto rounded border border-border bg-muted px-1.5 font-mono text-[0.7rem] text-muted-foreground"
        data-search-kbd
        aria-hidden="true">Ctrl K</kbd
      >
    </button>
    <button
      type="button"
      {...iconLook}
      class="hidden max-toc:inline-flex"
      data-open-search
      aria-haspopup="dialog"
      aria-keyshortcuts="Control+K Meta+K /"
      aria-label="Search docs"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
    </button>
    <div class="max-nav:hidden">
      <IconLibraryPicker client:load />
    </div>
    <ThemePicker client:load />
    <a {...iconLook} href={github} aria-label="Kimak on GitHub">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.6 1.1 1.6 1.1 1 .1.8 1.6 2.7 1.1.1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.3.8 1 .8 2.1v3.1c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"
        ></path>
      </svg>
    </a>
  </div>
</header>
<SearchDialog />
