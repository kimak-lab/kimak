---
import { FRAMEWORKS } from "../lib/nav";
import { iconButton, pillButton, pillGroup } from "../lib/chrome";

interface Props {
  nav?: boolean;
}

const { nav = false } = Astro.props;
const github = "https://github.com/kimak-lab/kimak";
const onDocs = Astro.url.pathname.startsWith("/docs");
---

<header
  class="sticky top-0 z-30 flex h-14 items-center justify-between gap-4 border-b border-border bg-docs-header px-5 backdrop-blur-[14px] max-nav:px-[0.85rem]"
>
  <div class="flex items-center gap-3">
    {
      nav ? (
        <button
          type="button"
          class:list={[iconButton, "hidden max-nav:inline-flex"]}
          data-toggle-nav
          aria-expanded="false"
          aria-controls="docs-nav"
        >
          <span class="sr-only">Open navigation</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
      ) : null
    }
    <a class="font-[650] tracking-[-0.04em]" href="/">Kimak</a>
    <nav class="flex items-center gap-3 max-nav:hidden" aria-label="Primary">
      <a
        class="text-[0.9rem] text-muted-foreground hover:text-foreground aria-[current=page]:text-foreground"
        href="/docs/getting-started"
        aria-current={onDocs ? "page" : undefined}
      >
        Docs
      </a>
    </nav>
  </div>
  <div class="flex items-center gap-3">
    <div class:list={[pillGroup, "max-nav:hidden"]} role="group" aria-label="Framework">
      {
        FRAMEWORKS.map((framework) => (
          <button type="button" class={pillButton} data-set-framework={framework} aria-pressed={framework === "react"}>
            {framework[0]?.toUpperCase() + framework.slice(1)}
          </button>
        ))
      }
    </div>
    <button
      type="button"
      class:list={[iconButton, "inline-flex"]}
      data-toggle-theme
      aria-pressed="false"
      aria-label="Switch to dark theme"
    >
      <svg
        class="dark:hidden"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"></path>
      </svg>
      <svg
        class="hidden dark:inline"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6.3 6.3l1.4 1.4M16.3 16.3l1.4 1.4M6.3 17.7l1.4-1.4M16.3 7.7l1.4-1.4"></path>
      </svg>
    </button>
    <a class:list={[iconButton, "inline-flex"]} href={github} aria-label="Kimak on GitHub">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.6 1.1 1.6 1.1 1 .1.8 1.6 2.7 1.1.1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.3.8 1 .8 2.1v3.1c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"
        ></path>
      </svg>
    </a>
  </div>
</header>
