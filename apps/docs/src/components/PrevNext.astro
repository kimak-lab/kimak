---
import { adjacent } from "../lib/nav";

interface Props {
  current: string;
}

const { current } = Astro.props;
const { prev, next } = adjacent(current);

const linkClass =
  "block rounded-[0.9rem] border border-border px-4 py-[0.9rem] no-underline hover:bg-muted";
const labelClass = "mb-0.5 block text-[0.72rem] tracking-[0.06em] text-muted-foreground uppercase";
---

{
  prev || next ? (
    <nav
      class="mt-11 grid grid-cols-2 gap-3 border-t border-border pt-6 max-nav:grid-cols-1"
      aria-label="Docs pagination"
    >
      {prev ? (
        <a class={linkClass} href={prev.href}>
          <span class={labelClass}>Previous</span>
          {prev.label}
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a class:list={[linkClass, "col-start-2 text-right max-nav:col-start-1 max-nav:text-left"]} href={next.href}>
          <span class={labelClass}>Next</span>
          {next.label}
        </a>
      ) : null}
    </nav>
  ) : null
}
