---
import { articleCard } from "../lib/chrome";
---

<nav
  class:list={[
    articleCard,
    "sticky top-[4.25rem] max-h-[calc(100vh-5.25rem)] overflow-auto px-3 pt-4 pb-6 max-toc:hidden",
  ]}
  aria-label="On this page"
  data-toc-root
  data-nav-inert
  hidden
>
  <p class="mb-[0.45rem] text-[0.7rem] font-[650] tracking-[0.08em] text-muted-foreground uppercase">
    On this page
  </p>
  <ol data-toc></ol>
</nav>
