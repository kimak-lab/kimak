---
import FrameworkTabs from "./FrameworkTabs.astro";
import { PopoverPreview as PopoverPreviewReact } from "../demos/popover/PopoverPreview.tsx";
import PopoverPreviewVue from "../demos/popover/PopoverPreview.vue";
import PopoverPreviewSvelte from "../demos/popover/PopoverPreview.svelte";
import { popoverSnippets, type PopoverExample } from "../lib/snippets/popover";

interface Props {
  example?: PopoverExample;
}

const { example = "basic" } = Astro.props;
---

<FrameworkTabs snippets={popoverSnippets[example]}>
  <PopoverPreviewReact client:load example={example} slot="react" />
  <PopoverPreviewVue client:load example={example} slot="vue" />
  <PopoverPreviewSvelte client:load example={example} slot="svelte" />
</FrameworkTabs>
