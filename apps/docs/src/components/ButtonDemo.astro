---
import FrameworkTabs from "./FrameworkTabs.astro";
import { ButtonPreview as ButtonPreviewReact } from "../demos/button/ButtonPreview.tsx";
import ButtonPreviewVue from "../demos/button/ButtonPreview.vue";
import ButtonPreviewSvelte from "../demos/button/ButtonPreview.svelte";
import { buttonSnippets, type ButtonExample } from "../lib/snippets/button";

interface Props {
  example?: ButtonExample;
}

const { example = "playground" } = Astro.props;
const snippets = buttonSnippets[example];
---

<FrameworkTabs snippets={snippets}>
  <ButtonPreviewReact client:load example={example} slot="react" />
  <ButtonPreviewVue client:load example={example} slot="vue" />
  <ButtonPreviewSvelte client:load example={example} slot="svelte" />
</FrameworkTabs>
