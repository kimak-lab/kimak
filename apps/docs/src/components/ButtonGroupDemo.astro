---
import FrameworkTabs from "./FrameworkTabs.astro";
import { ButtonGroupPreview as ButtonGroupPreviewReact } from "../demos/button-group/ButtonGroupPreview.tsx";
import ButtonGroupPreviewVue from "../demos/button-group/ButtonGroupPreview.vue";
import ButtonGroupPreviewSvelte from "../demos/button-group/ButtonGroupPreview.svelte";
import { buttonGroupSnippets, type ButtonGroupExample } from "../lib/snippets/button-group";

interface Props {
  example?: ButtonGroupExample;
}

const { example = "basic" } = Astro.props;
---

<FrameworkTabs snippets={buttonGroupSnippets[example]}>
  <ButtonGroupPreviewReact client:load example={example} slot="react" />
  <ButtonGroupPreviewVue client:load example={example} slot="vue" />
  <ButtonGroupPreviewSvelte client:load example={example} slot="svelte" />
</FrameworkTabs>
