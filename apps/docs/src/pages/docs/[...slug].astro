---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description}>
  <p class="mb-3 text-xs tracking-[0.08em] text-muted-foreground uppercase">{entry.data.section}</p>
  <h1
    class="mb-[0.85rem] text-[clamp(2rem,4vw,2.85rem)] font-[650] leading-[1.08] tracking-[-0.045em]"
  >
    {entry.data.title}
  </h1>
  <p class="mb-6 max-w-[40rem] text-[1.12rem] text-muted-foreground">{entry.data.description}</p>
  <div class="prose">
    <Content />
  </div>
</DocsLayout>
