---
import HomeLayout from "../layouts/HomeLayout.astro";
import ButtonDemo from "../components/ButtonDemo.astro";
import LinkButton from "../components/LinkButton.astro";
---

<HomeLayout
  title="Kimak"
  description="Headless UI primitives. React-first. Framework-agnostic kernel."
>
  <p class="eyebrow">Headless UI</p>
  <div class="hero">
    <h1>Behavior in the kernel. Look in your CSS.</h1>
    <p class="lede">
      Kimak owns keyboard, focus, and ARIA. Style with anatomy selectors — or opt into the Tailwind
      plugin. React is first. Vue and Svelte ship Button in lockstep.
    </p>
    <div class="hero-actions">
      <LinkButton href="/docs/getting-started">Get started</LinkButton>
      <LinkButton href="/docs/components/button" variant="outline">View Button</LinkButton>
    </div>
  </div>

  <ButtonDemo example="playground" />

  <div class="home-cards">
    <a class="home-card-link" href="/docs/installation">
      <h2>Install</h2>
      <p>React on npm. Vue and Svelte from the workspace. Tailwind plugin for look.</p>
    </a>
    <a class="home-card-link" href="/docs/styling">
      <h2>Style</h2>
      <p>data-scope, data-slot, and data-state. Size and variant stay off the machine.</p>
    </a>
    <a class="home-card-link" href="/docs/components/button">
      <h2>Button</h2>
      <p>Variants, sizes, loading that stays in the tab order, and the spec tables.</p>
    </a>
  </div>
</HomeLayout>
