---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Headless UI primitives. React-first. Framework-agnostic kernel." } =
  Astro.props;
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth data-nav-open:overflow-hidden" data-framework="react">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const theme = localStorage.getItem("kimak.docs.theme");
          const dark =
            theme === "dark" ||
            (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
          root.classList.toggle("dark", dark);
          const framework = localStorage.getItem("kimak.docs.framework");
          if (framework === "react" || framework === "vue" || framework === "svelte") {
            root.dataset.framework = framework;
          }
        } catch {
          /* private mode */
        }
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-docs-canvas bg-[radial-gradient(var(--docs-dot)_0.85px,transparent_0.85px)] bg-size-[18px_18px] font-sans leading-relaxed text-foreground"
  >
    <slot />
    <script src="../scripts/prefs.ts"></script>
  </body>
</html>
